        "source": {
          "file": "DL2-13771.pdf",
          "page": 1,
          "revision_date": "2006-07-01"
        }
      },
      "secondary": {
        "value": "can be used as a primary or secondary antioxidant ... in combination with suitable Naugalube aminic antioxidants",
        "status": "Reported",
        "source": {
          "file": "DL2-13771.pdf",
          "page": 1,
          "revision_date": "2006-07-01"
        },
        "notes": "TDS explicitly states it can serve as either primary OR secondary AO; also noted for synergy with aminic (secondary amine) antioxidants"
      }
