    "function": {
      "primary": {
        "value": "Kraton G1750 V is a clear, multi-arm polymer based on ethylene/propylene. It is used as a modifier of polymers.",
        "status": "Reported",
        "source": {
          "file": "DL2-15682.pdf",
          "page": 1,
          "revision_date": null
        },
        "notes": "TDS describes \"modifier of polymers\" and footwear/adhesives use; in lubricant context, EP copolymers (OCP) are used as viscosity index improvers; Styrene/Rubber ratio 0/100 confirms no styrene block — pure EP rubber polymer"
      },
      "secondary": {
